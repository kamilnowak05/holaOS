{
  "name": "holaboss-local",
  "private": true,
  "version": "0.1.0",
  "main": "../out/desktop/dist-electron/main.cjs",
  "scripts": {
    "clean": "rm -rf ../out/desktop out build",
    "predev": "kill-port 5173",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:build\" \"npm:dev:electron:run\"",
    "dev:cp:local": "cross-env PROACTIVE_ENABLE_REMOTE_BRIDGE=true PROACTIVE_BRIDGE_BASE_URL=http://127.0.0.1:3032 HOLABOSS_PROACTIVE_URL=http://127.0.0.1:3032 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://127.0.0.1:3060 HOLABOSS_PROJECTS_URL=http://127.0.0.1:3033 HOLABOSS_MARKETPLACE_URL=http://127.0.0.1:3037 npm run dev",
    "dev:cp:local:oss": "cross-env HOLABOSS_RUNTIME_FLAVOR=oss PROACTIVE_ENABLE_REMOTE_BRIDGE=true PROACTIVE_BRIDGE_BASE_URL=http://127.0.0.1:3032 HOLABOSS_PROACTIVE_URL=http://127.0.0.1:3032 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://127.0.0.1:3060 HOLABOSS_PROJECTS_URL=http://127.0.0.1:3033 HOLABOSS_MARKETPLACE_URL=http://127.0.0.1:3037 npm run dev",
    "dev:cp:local:verbose": "cross-env HOLABOSS_VERBOSE_TELEMETRY=1 PROACTIVE_ENABLE_REMOTE_BRIDGE=true PROACTIVE_BRIDGE_BASE_URL=http://127.0.0.1:3032 HOLABOSS_PROACTIVE_URL=http://127.0.0.1:3032 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://127.0.0.1:3060 HOLABOSS_PROJECTS_URL=http://127.0.0.1:3033 HOLABOSS_MARKETPLACE_URL=http://127.0.0.1:3037 npm run dev",
    "dev:cp:dev": "cross-env HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://54.214.105.154:3060 HOLABOSS_PROJECTS_URL=http://54.214.105.154:3033 HOLABOSS_MARKETPLACE_URL=http://54.214.105.154:3037 npm run dev",
    "dev:cp:dev:verbose": "cross-env HOLABOSS_VERBOSE_TELEMETRY=1 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://54.214.105.154:3060 HOLABOSS_PROJECTS_URL=http://54.214.105.154:3033 HOLABOSS_MARKETPLACE_URL=http://54.214.105.154:3037 npm run dev",
    "dev:cp:prod": "cross-env HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://35.160.37.189:3060 HOLABOSS_PROJECTS_URL=http://35.160.37.189:3033 HOLABOSS_MARKETPLACE_URL=http://35.160.37.189:3037 npm run dev",
    "dev:cp:prod:verbose": "cross-env HOLABOSS_VERBOSE_TELEMETRY=1 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://35.160.37.189:3060 HOLABOSS_PROJECTS_URL=http://35.160.37.189:3033 HOLABOSS_MARKETPLACE_URL=http://35.160.37.189:3037 npm run dev",
    "dev:renderer": "vite",
    "dev:electron:build": "tsup --config tsup.config.ts --watch",
    "dev:electron:run": "wait-on tcp:5173 file:../out/desktop/dist-electron/main.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electronmon ../out/desktop/dist-electron/main.cjs",
    "prepare:runtime": "node scripts/stage-runtime-bundle.mjs",
    "prepare:runtime:local": "node scripts/prepare-runtime-local.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsup --config tsup.config.ts --minify",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "dist:mac": "npm run prepare:runtime && npm run build && electron-builder --mac dir --arm64 --config.mac.identity=null",
    "dist:mac:local": "npm run prepare:runtime:local && npm run build && electron-builder --mac dir --arm64 --config.mac.identity=null",
    "dist:mac:dmg": "npm run prepare:runtime && npm run build && electron-builder --mac dmg --arm64 --config.mac.identity=null",
    "dist:mac:dmg:local": "npm run prepare:runtime:local && npm run build && electron-builder --mac dmg --arm64 --config.mac.identity=null",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "packaged:run": "node scripts/run-packaged.mjs",
    "packaged:run:local": "cross-env PROACTIVE_ENABLE_REMOTE_BRIDGE=true PROACTIVE_BRIDGE_BASE_URL=http://127.0.0.1:3032 HOLABOSS_PROACTIVE_URL=http://127.0.0.1:3032 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://127.0.0.1:3060 HOLABOSS_PROJECTS_URL=http://127.0.0.1:3033 HOLABOSS_MARKETPLACE_URL=http://127.0.0.1:3037 npm run packaged:run",
    "packaged:run:local:oss": "cross-env HOLABOSS_RUNTIME_FLAVOR=oss PROACTIVE_ENABLE_REMOTE_BRIDGE=true PROACTIVE_BRIDGE_BASE_URL=http://127.0.0.1:3032 HOLABOSS_PROACTIVE_URL=http://127.0.0.1:3032 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://127.0.0.1:3060 HOLABOSS_PROJECTS_URL=http://127.0.0.1:3033 HOLABOSS_MARKETPLACE_URL=http://127.0.0.1:3037 npm run packaged:run",
    "packaged:run:local:verbose": "cross-env HOLABOSS_VERBOSE_TELEMETRY=1 PROACTIVE_ENABLE_REMOTE_BRIDGE=true PROACTIVE_BRIDGE_BASE_URL=http://127.0.0.1:3032 HOLABOSS_PROACTIVE_URL=http://127.0.0.1:3032 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://127.0.0.1:3060 HOLABOSS_PROJECTS_URL=http://127.0.0.1:3033 HOLABOSS_MARKETPLACE_URL=http://127.0.0.1:3037 npm run packaged:run",
    "packaged:run:dev": "cross-env HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://54.214.105.154:3060 HOLABOSS_PROJECTS_URL=http://54.214.105.154:3033 HOLABOSS_MARKETPLACE_URL=http://54.214.105.154:3037 npm run packaged:run",
    "packaged:run:dev:verbose": "cross-env HOLABOSS_VERBOSE_TELEMETRY=1 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://54.214.105.154:3060 HOLABOSS_PROJECTS_URL=http://54.214.105.154:3033 HOLABOSS_MARKETPLACE_URL=http://54.214.105.154:3037 npm run packaged:run",
    "packaged:run:prod": "cross-env HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://35.160.37.189:3060 HOLABOSS_PROJECTS_URL=http://35.160.37.189:3033 HOLABOSS_MARKETPLACE_URL=http://35.160.37.189:3037 npm run packaged:run",
    "packaged:run:prod:verbose": "cross-env HOLABOSS_VERBOSE_TELEMETRY=1 HOLABOSS_DESKTOP_CONTROL_PLANE_BASE_URL=http://35.160.37.189:3060 HOLABOSS_PROJECTS_URL=http://35.160.37.189:3033 HOLABOSS_MARKETPLACE_URL=http://35.160.37.189:3037 npm run packaged:run"
  },
  "dependencies": {
    "@better-auth/electron": "^1.5.5",
    "better-auth": "^1.5.5",
    "better-sqlite3": "^12.8.0",
    "conf": "^15.1.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.holaboss.workspace",
    "productName": "Holaboss Workspace",
    "directories": {
      "output": "../out/desktop/release"
    },
    "files": [
      "../out/desktop/dist/**/*",
      "../out/desktop/dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../out/desktop/runtime-macos",
        "to": "runtime-macos",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Holaboss Auth Callback",
        "schemes": [
          "ai.holaboss.app"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
